{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["sentinelops-lite", "ai-agent"],
  "templating": {
    "list": [
      {
        "name": "agent",
        "type": "query",
        "label": "Agent",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(agent_last_run_timestamp_seconds, agent_name)", "refId": "A"},
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "AI Agent",
  "uid": "ai-agent",
  "version": 3,
  "refresh": "10s",
  "panels": [
    { "id": 100, "type": "row", "title": "Overview — All 3 Agents",
      "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "panels": [] },

    {
      "id": 1, "type": "stat", "title": "Reported Agents",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 1},
      "fieldConfig": {"defaults": {"unit": "short",
        "thresholds": {"mode": "absolute", "steps":
          [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 3}]}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "count(count by (agent_name) (agent_last_run_timestamp_seconds))"}]
    },
    {
      "id": 2, "type": "stat", "title": "Total Tokens (all agents)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 5, "x": 4, "y": 1},
      "fieldConfig": {"defaults": {"unit": "short",
        "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(agent_token_usage_total)", "legendFormat": "tokens"}]
    },
    {
      "id": 3, "type": "stat", "title": "Total API Calls",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 5, "x": 9, "y": 1},
      "fieldConfig": {"defaults": {"unit": "short",
        "color": {"mode": "fixed", "fixedColor": "purple"}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(agent_api_calls_total)", "legendFormat": "calls"}]
    },
    {
      "id": 4, "type": "stat", "title": "Total Tasks",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 5, "x": 14, "y": 1},
      "fieldConfig": {"defaults": {"unit": "short",
        "color": {"mode": "fixed", "fixedColor": "green"}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(agent_tasks_total)", "legendFormat": "tasks"}]
    },
    {
      "id": 5, "type": "stat", "title": "Most Recent Report",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 5, "x": 19, "y": 1},
      "fieldConfig": {"defaults": {"unit": "dateTimeAsIso"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "max(agent_last_run_timestamp_seconds) * 1000"}]
    },

    {
      "id": 6, "type": "timeseries", "title": "Tokens per Minute (all agents)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "fieldConfig": {"defaults": {"unit": "short",
        "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum(rate(agent_prompt_tokens_total[$__rate_interval])) * 60",     "legendFormat": "prompt/min"},
        {"refId": "B", "expr": "sum(rate(agent_completion_tokens_total[$__rate_interval])) * 60", "legendFormat": "completion/min"},
        {"refId": "C", "expr": "sum(rate(agent_token_usage_total[$__rate_interval])) * 60",       "legendFormat": "total/min"}
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "API Calls per Minute (success vs failed)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "fieldConfig": {"defaults": {"unit": "short",
        "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum(rate(agent_api_calls_total{status=\"success\"}[$__rate_interval])) * 60", "legendFormat": "success/min"},
        {"refId": "B", "expr": "sum(rate(agent_api_calls_total{status=\"failed\"}[$__rate_interval])) * 60",  "legendFormat": "failed/min"}
      ]
    },

    {
      "id": 8, "type": "bargauge", "title": "Tokens by Agent",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"orientation": "horizontal", "displayMode": "gradient"},
      "targets": [{"refId": "A", "expr": "sum by (agent_name) (agent_token_usage_total)", "legendFormat": "{{agent_name}}"}]
    },
    {
      "id": 9, "type": "piechart", "title": "Prompt vs Completion Tokens",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum(agent_prompt_tokens_total)",     "legendFormat": "prompt"},
        {"refId": "B", "expr": "sum(agent_completion_tokens_total)", "legendFormat": "completion"}
      ]
    },
    {
      "id": 10, "type": "barchart", "title": "Task Outcomes",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (result) (agent_tasks_total)", "legendFormat": "{{result}}"}]
    },

    { "id": 200, "type": "row", "title": "test_agent (pre-check)",
      "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22}, "panels": [] },

    {
      "id": 21, "type": "stat", "title": "test_agent Tokens",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 23},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(agent_token_usage_total{agent_name=\"test_agent\"})"}]
    },
    {
      "id": 22, "type": "stat", "title": "test_agent API Calls",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 23},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "purple"}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(agent_api_calls_total{agent_name=\"test_agent\"})"}]
    },
    {
      "id": 23, "type": "stat", "title": "test_agent State",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 23},
      "fieldConfig": {"defaults": {"unit": "string"}, "overrides": []},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^state$/", "values": false},
        "textMode": "value", "colorMode": "value", "graphMode": "none"
      },
      "targets": [{"refId": "A", "expr": "agent_state{agent_name=\"test_agent\"} == 1", "instant": true, "format": "table"}]
    },
    {
      "id": 24, "type": "stat", "title": "test_agent Last Report",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 23},
      "fieldConfig": {"defaults": {"unit": "dateTimeAsIso"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "agent_last_run_timestamp_seconds{agent_name=\"test_agent\"} * 1000"}]
    },
    {
      "id": 25, "type": "timeseries", "title": "test_agent Tokens/min",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "fieldConfig": {"defaults": {"unit": "short",
        "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []},
      "targets": [
        {"refId": "A", "expr": "rate(agent_prompt_tokens_total{agent_name=\"test_agent\"}[$__rate_interval]) * 60",     "legendFormat": "prompt"},
        {"refId": "B", "expr": "rate(agent_completion_tokens_total{agent_name=\"test_agent\"}[$__rate_interval]) * 60", "legendFormat": "completion"},
        {"refId": "C", "expr": "rate(agent_token_usage_total{agent_name=\"test_agent\"}[$__rate_interval]) * 60",       "legendFormat": "total"}
      ]
    },
    {
      "id": 26, "type": "timeseries", "title": "test_agent Requests/min",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "fieldConfig": {"defaults": {"unit": "short",
        "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []},
      "targets": [
        {"refId": "A", "expr": "rate(agent_api_calls_total{agent_name=\"test_agent\",status=\"success\"}[$__rate_interval]) * 60", "legendFormat": "success"},
        {"refId": "B", "expr": "rate(agent_api_calls_total{agent_name=\"test_agent\",status=\"failed\"}[$__rate_interval]) * 60",  "legendFormat": "failed"}
      ]
    },

    { "id": 300, "type": "row", "title": "errors (during-check)",
      "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 36}, "panels": [] },

    {
      "id": 31, "type": "stat", "title": "errors Tokens",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 37},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(agent_token_usage_total{agent_name=\"errors\"})"}]
    },
    {
      "id": 32, "type": "stat", "title": "errors API Calls",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 37},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "purple"}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(agent_api_calls_total{agent_name=\"errors\"})"}]
    },
    {
      "id": 33, "type": "stat", "title": "errors State",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 37},
      "fieldConfig": {"defaults": {"unit": "string"}, "overrides": []},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^state$/", "values": false},
        "textMode": "value", "colorMode": "value", "graphMode": "none"
      },
      "targets": [{"refId": "A", "expr": "agent_state{agent_name=\"errors\"} == 1", "instant": true, "format": "table"}]
    },
    {
      "id": 34, "type": "stat", "title": "errors Last Report",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 37},
      "fieldConfig": {"defaults": {"unit": "dateTimeAsIso"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "agent_last_run_timestamp_seconds{agent_name=\"errors\"} * 1000"}]
    },
    {
      "id": 35, "type": "timeseries", "title": "errors Tokens/min",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 42},
      "fieldConfig": {"defaults": {"unit": "short",
        "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []},
      "targets": [
        {"refId": "A", "expr": "rate(agent_prompt_tokens_total{agent_name=\"errors\"}[$__rate_interval]) * 60",     "legendFormat": "prompt"},
        {"refId": "B", "expr": "rate(agent_completion_tokens_total{agent_name=\"errors\"}[$__rate_interval]) * 60", "legendFormat": "completion"},
        {"refId": "C", "expr": "rate(agent_token_usage_total{agent_name=\"errors\"}[$__rate_interval]) * 60",       "legendFormat": "total"}
      ]
    },
    {
      "id": 36, "type": "timeseries", "title": "errors Requests/min",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 42},
      "fieldConfig": {"defaults": {"unit": "short",
        "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []},
      "targets": [
        {"refId": "A", "expr": "rate(agent_api_calls_total{agent_name=\"errors\",status=\"success\"}[$__rate_interval]) * 60", "legendFormat": "success"},
        {"refId": "B", "expr": "rate(agent_api_calls_total{agent_name=\"errors\",status=\"failed\"}[$__rate_interval]) * 60",  "legendFormat": "failed"}
      ]
    },

    { "id": 400, "type": "row", "title": "final_agent (post-check)",
      "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 50}, "panels": [] },

    {
      "id": 41, "type": "stat", "title": "final_agent Tokens",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 51},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(agent_token_usage_total{agent_name=\"final_agent\"})"}]
    },
    {
      "id": 42, "type": "stat", "title": "final_agent API Calls",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 51},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "purple"}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(agent_api_calls_total{agent_name=\"final_agent\"})"}]
    },
    {
      "id": 43, "type": "stat", "title": "final_agent State",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 51},
      "fieldConfig": {"defaults": {"unit": "string"}, "overrides": []},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^state$/", "values": false},
        "textMode": "value", "colorMode": "value", "graphMode": "none"
      },
      "targets": [{"refId": "A", "expr": "agent_state{agent_name=\"final_agent\"} == 1", "instant": true, "format": "table"}]
    },
    {
      "id": 44, "type": "stat", "title": "final_agent Last Report",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 51},
      "fieldConfig": {"defaults": {"unit": "dateTimeAsIso"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "agent_last_run_timestamp_seconds{agent_name=\"final_agent\"} * 1000"}]
    },
    {
      "id": 45, "type": "timeseries", "title": "final_agent Tokens/min",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56},
      "fieldConfig": {"defaults": {"unit": "short",
        "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []},
      "targets": [
        {"refId": "A", "expr": "rate(agent_prompt_tokens_total{agent_name=\"final_agent\"}[$__rate_interval]) * 60",     "legendFormat": "prompt"},
        {"refId": "B", "expr": "rate(agent_completion_tokens_total{agent_name=\"final_agent\"}[$__rate_interval]) * 60", "legendFormat": "completion"},
        {"refId": "C", "expr": "rate(agent_token_usage_total{agent_name=\"final_agent\"}[$__rate_interval]) * 60",       "legendFormat": "total"}
      ]
    },
    {
      "id": 46, "type": "timeseries", "title": "final_agent Requests/min",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56},
      "fieldConfig": {"defaults": {"unit": "short",
        "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []},
      "targets": [
        {"refId": "A", "expr": "rate(agent_api_calls_total{agent_name=\"final_agent\",status=\"success\"}[$__rate_interval]) * 60", "legendFormat": "success"},
        {"refId": "B", "expr": "rate(agent_api_calls_total{agent_name=\"final_agent\",status=\"failed\"}[$__rate_interval]) * 60",  "legendFormat": "failed"}
      ]
    },

    { "id": 500, "type": "row", "title": "Auto-detected Agents (dropdown filter)",
      "collapsed": true, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 64},
      "panels": [
        {
          "id": 51, "type": "table", "title": "All Agents Overview",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "gridPos": {"h": 8, "w": 24, "x": 0, "y": 65},
          "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": []},
          "targets": [
            {"refId": "A",
             "expr": "sum by (agent_name, stage) (agent_token_usage_total{agent_name=~\"$agent\"})",
             "instant": true, "format": "table"}
          ],
          "transformations": [
            {"id": "organize",
             "options": {
               "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true},
               "renameByName": {"agent_name": "Agent", "stage": "Stage", "Value": "Tokens"}
             }}
          ]
        },
        {
          "id": 52, "type": "timeseries", "title": "Tokens/min by Agent (filtered)",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 73},
          "fieldConfig": {"defaults": {"unit": "short",
            "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}},
            "overrides": []},
          "targets": [
            {"refId": "A",
             "expr": "sum by (agent_name) (rate(agent_token_usage_total{agent_name=~\"$agent\"}[$__rate_interval])) * 60",
             "legendFormat": "{{agent_name}}"}
          ]
        },
        {
          "id": 53, "type": "timeseries", "title": "API Calls/min by Agent (filtered)",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 73},
          "fieldConfig": {"defaults": {"unit": "short",
            "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}},
            "overrides": []},
          "targets": [
            {"refId": "A",
             "expr": "sum by (agent_name) (rate(agent_api_calls_total{agent_name=~\"$agent\"}[$__rate_interval])) * 60",
             "legendFormat": "{{agent_name}}"}
          ]
        }
      ]
    }
  ]
}